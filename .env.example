# Meta Model API (Muse Spark and SAM 3.1)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1

# Open-weight option: Muse Spark Open on Baseten
OPEN_MODEL_BASE_URL=https://inference.baseten.co/v1
OPEN_MODEL_API_KEY=
OPEN_MODEL_ID=meta-models/muse-spark-open-1026

# NYC data
SOCRATA_APP_TOKEN=
NYC_GEOCLIENT_KEY=

# Street photos (optional)
MAPILLARY_TOKEN=

# Hard spend caps: a spend alert does not stop billing, so these stop calls in code
DAILY_SPEND_CAP_USD=5
MAX_CALLS_PER_INVESTIGATION=60

# Prices used for spend estimates (reported prices; check your Billing page)
MUSE_INPUT_USD_PER_M=1.25
MUSE_OUTPUT_USD_PER_M=4.25
SAM_USD_PER_IMAGE=0.0025
# Placeholder prices for the open model until Baseten's pricing is checked
OPEN_MODEL_INPUT_USD_PER_M=1.25
OPEN_MODEL_OUTPUT_USD_PER_M=4.25
